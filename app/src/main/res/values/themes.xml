<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Fixed dark theme; the window background is the app's. -->
    <style name="Theme.TikStik" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:colorBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Start-up on Android 8–11: the same framing as the Android 12+ system splash. -->
    <style name="Theme.TikStik.Starting">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:navigationBarColor">@color/brand_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

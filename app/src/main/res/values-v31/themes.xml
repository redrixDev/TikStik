<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- System splash with the sticker not yet peeling: the Compose animation starts from this framing. -->
    <style name="Theme.TikStik.Starting">
        <item name="android:windowSplashScreenBackground">@color/brand_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

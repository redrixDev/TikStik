<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup: the backup is the Drive one. On a transfer to another phone: collection, database and settings; not the regenerable copies nor the pairing. allowBackup=true: with false, only some manufacturers do the transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="originals/" />
        <include domain="file" path="datastore/" />
        <!-- Only TikStik's database (with its WAL), not the libraries' ones. -->
        <include domain="database" path="tikstik.db" />
        <include domain="database" path="tikstik.db-wal" />
    </device-transfer>
</data-extraction-rules>
